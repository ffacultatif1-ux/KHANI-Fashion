# ============================================================
# KHANI Fashion - Variables d'environnement (MODÈLE)
#
# 1. Copiez ce fichier et nommez la copie ".env" (à la racine)
# 2. Remplissez vos valeurs réelles dans ".env"
# 3. Le fichier ".env" ne doit JAMAIS être publié sur GitHub
#    (il est déjà listé dans .gitignore)
# ============================================================

# Driver de base de données : 'pgsql' (Supabase) ou 'mysql' (XAMPP local)
DB_DRIVER=pgsql

# ------------------------------------------------------------
# PostgreSQL / SUPABASE
# Dans Supabase : Project Settings > Database > Connection string
# > section "Session pooler" (port 5432, recommandé).
#   - Host : ressemble à aws-0-<region>.pooler.supabase.com
#   - User : ressemble à postgres.<reference-du-projet>
#   - Password : le mot de passe de votre projet Supabase
# ------------------------------------------------------------
PGSQL_HOST=
PGSQL_PORT=5432
PGSQL_DBNAME=postgres
PGSQL_USER=
PGSQL_PASSWORD=
PGSQL_SSLMODE=require

# ------------------------------------------------------------
# MySQL local (XAMPP) — utilisé uniquement si DB_DRIVER=mysql
# ------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DBNAME=khani_fashion
MYSQL_USER=root
MYSQL_PASSWORD=

# Mode debug : 1 = afficher les erreurs (développement), 0 = production
DEBUG_MODE=1
