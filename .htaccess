# KHANI Fashion - Configuration Apache

# Encodage par défaut
AddDefaultCharset UTF-8

# Sécurité : bloquer l'accès aux dossiers api/config et api/includes
<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>

# Sécurité : bloquer tout accès web aux dossiers de configuration et de classes
# (les fichiers sont chargés par require_once côté serveur, jamais via HTTP)
# Voir aussi api/config/.htaccess et api/includes/.htaccess

# Sécurité : bloquer l'accès au fichier des secrets
<FilesMatch "^\.env|\.env\.">
    Require all denied
</FilesMatch>

# Sécurité : scripts de maintenance / migration inaccessibles depuis le web
<FilesMatch "^(install|migrate_to_supabase)\.php$">
    Require all denied
</FilesMatch>


# Page d'accueil par défaut
DirectoryIndex index.html

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>

# Cache des assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
